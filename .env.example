APP_NAME=autowz
APP_ENV=dev
APP_DEBUG=true
API_PREFIX=/api/v1
# 当前启用的内容模块：finance 或 entertainment；默认 entertainment
ACTIVE_MODULE=entertainment

WECHAT_APP_ID=your-wechat-app-id
WECHAT_APP_SECRET=your-wechat-app-secret
WECHAT_BASE_URL=https://api.weixin.qq.com
WECHAT_ENABLE_AUTO_PUBLISH=false
WECHAT_FALLBACK_TO_DRAFT=true

CONTENT_AUTHOR=知微观澜
DEFAULT_COMMENT_OPEN=1
DEFAULT_FANS_COMMENT_ONLY=0

OPENAI_API_KEY=your-openai-api-key
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5.4

XAI_API_KEY=your-xai-api-key-here

REDIS_URL=redis://localhost:6379/0
MYSQL_DSN=mysql+pymysql://root:password@localhost:3306/autowz?charset=utf8mb4

# 图片生成 provider 列表通过单独的 JSON 文件管理（默认 image_providers.json，见 image_providers.example.json）
# 多个 provider 按文件中数组顺序依次故障转移；同一 provider 的多个 model 也按顺序尝试
# 增删 provider 只改 JSON，不需要改代码；如需自定义路径，取消下面注释
# IMAGE_PROVIDERS_FILE=image_providers.json
