APP_NAME=autowz
APP_ENV=dev
APP_DEBUG=true
API_PREFIX=/api/v1

WECHAT_APP_ID=your-wechat-app-id
WECHAT_APP_SECRET=your-wechat-app-secret
WECHAT_BASE_URL=https://api.weixin.qq.com
WECHAT_ENABLE_AUTO_PUBLISH=false
WECHAT_FALLBACK_TO_DRAFT=true

CONTENT_AUTHOR=知微观澜
DEFAULT_COMMENT_OPEN=1
DEFAULT_FANS_COMMENT_ONLY=0

OPENAI_API_KEY=your-openai-api-key
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5.4

XAI_API_KEY=your-xai-api-key-here

REDIS_URL=redis://localhost:6379/0
MYSQL_DSN=mysql+pymysql://root:password@localhost:3306/autowz?charset=utf8mb4

# Image generation fallback order: GPT -> Grok -> SenseNova
# Primary: 直接走 OpenAI 兼容接口（如 speak.codes / 官方 OpenAI 等）
# 当该接口必须通过代理访问时配置 IMAGE_API_PROXY（仅作用于本 provider，不影响全局网络）
IMAGE_API_KEY=your_openai_compatible_image_api_key
IMAGE_API_URL=https://api.openai.com/v1/images/generations
IMAGE_MODEL=gpt-image-1
IMAGE_API_PROXY=

# Fallback 1: 如商汤 SenseNova
IMAGE_FALLBACK_API_KEY=your_sensenova_image_api_key
IMAGE_FALLBACK_API_URL=https://token.sensenova.cn/v1/images/generations
IMAGE_FALLBACK_MODELS=sensenova-u1-fast
IMAGE_FALLBACK_PROXY=

# Fallback 2: 其它聚合站（可选，留空则跳过）
IMAGE_FALLBACK2_API_KEY=
IMAGE_FALLBACK2_API_URL=
IMAGE_FALLBACK2_MODELS=
IMAGE_FALLBACK2_PROXY=
